# PicGen runtime configuration — copy to `.env` and edit.

# ---- Upstream defaults -------------------------------------------------
PICGEN_DEFAULT_GENERATE_URL=https://sub.tidba.com/v1/images/generations
PICGEN_DEFAULT_EDIT_URL=https://sub.tidba.com/v1/images/edits
PICGEN_DEFAULT_RESPONSES_URL=https://sub.tidba.com/v1/responses
PICGEN_DEFAULT_MODEL=gpt-image-2
PICGEN_DEFAULT_RESPONSES_MODEL=gpt-5.6-sol
PICGEN_DEFAULT_SIZE=1088x2240

# Server-side default API key (clients may leave the input blank).
PICGEN_DEFAULT_API_KEY=

# Optional bearer token enforced on /api/* (header X-Proxy-Token or Authorization).
PICGEN_PROXY_AUTH_TOKEN=

# ---- Upstream HTTP client tuning ---------------------------------------
PICGEN_UPSTREAM_TIMEOUT_SECONDS=1200
PICGEN_UPSTREAM_CONNECT_TIMEOUT_SECONDS=15
PICGEN_UPSTREAM_MAX_CONNECTIONS=64
PICGEN_UPSTREAM_MAX_KEEPALIVE=16
PICGEN_UPSTREAM_MAX_RETRIES=2
PICGEN_UPSTREAM_RETRY_BACKOFF=0.75
# 上游按比例缩小返回时的自动重生成次数（仅精确尺寸+单张时生效）。
# 默认 0=关闭：当前上游是确定性缩小，重试只会重复扣费拿到同样结果；
# 如果上游恢复为"偶尔缩小"，再改成 1-2。
PICGEN_SIZE_MISMATCH_MAX_RETRIES=0
PICGEN_UPSTREAM_USER_AGENT=

# ---- Request limits ----------------------------------------------------
PICGEN_MAX_REQUEST_BODY_BYTES=67108864
PICGEN_MAX_IMAGE_BYTES=33554432
PICGEN_RATE_LIMIT_PER_MINUTE=120
PICGEN_RATE_LIMIT_BURST=20

# ---- Networking --------------------------------------------------------
# Comma-separated origins. Leave empty to disable CORS (recommended on localhost).
PICGEN_CORS_ALLOW_ORIGINS=
PICGEN_CORS_ALLOW_CREDENTIALS=false
# Enable when sitting behind a reverse proxy that sets X-Forwarded-For.
PICGEN_TRUST_FORWARDED_FOR=false

# ---- Observability -----------------------------------------------------
PICGEN_LOG_LEVEL=INFO
PICGEN_LOG_FORMAT=console

# ---- Storage -----------------------------------------------------------
# Auto-purge day-folders older than N days while the server runs. 0 disables it.
PICGEN_STORAGE_RETENTION_DAYS=0

# ---- Authentication ----------------------------------------------------
PICGEN_AUTH_ENABLED=true
# Disabled by default. Enable only for a trusted, local auth-disabled deployment.
PICGEN_ALLOW_ANONYMOUS_EXECUTION_OVERRIDES=false
PICGEN_AUTH_DB_PATH=
# Built-in administrator. Set this in production; the password is synced on startup.
PICGEN_ADMIN_USERNAME=admin
PICGEN_ADMIN_PASSWORD=

# ---- Self-service password reset email --------------------------------
# Public URL used in password-reset email links. Leave empty to use request origin.
PICGEN_PUBLIC_BASE_URL=
# Aliyun DirectMail example: smtpdm.aliyun.com + SSL 465.
PICGEN_SMTP_HOST=
PICGEN_SMTP_PORT=465
PICGEN_SMTP_USERNAME=
PICGEN_SMTP_PASSWORD=
PICGEN_SMTP_FROM_EMAIL=
PICGEN_SMTP_FROM_NAME=PicGen
PICGEN_SMTP_USE_TLS=true
PICGEN_SMTP_STARTTLS=false
PICGEN_SMTP_TIMEOUT_SECONDS=10
PICGEN_PASSWORD_RESET_TOKEN_MINUTES=30

# ---- Bug feedback notifications ---------------------------------------
# Optional webhook for bug reports. Supported kinds: wecom, serverchan, generic.
PICGEN_BUG_REPORT_WEBHOOK_URL=
PICGEN_BUG_REPORT_WEBHOOK_KIND=wecom
PICGEN_BUG_REPORT_WEBHOOK_TIMEOUT_SECONDS=5

# Runtime error alerts to Telegram. When both values are set, operational
# backend/upstream errors are sent to this chat with sensitive values redacted.
PICGEN_ERROR_ALERT_TELEGRAM_BOT_TOKEN=
PICGEN_ERROR_ALERT_TELEGRAM_CHAT_ID=
PICGEN_ERROR_ALERT_TELEGRAM_TIMEOUT_SECONDS=3
