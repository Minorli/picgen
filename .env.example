# PicGen runtime configuration — copy to `.env` and edit.

# ---- Upstream defaults -------------------------------------------------
PICGEN_DEFAULT_GENERATE_URL=https://api.openai.com/v1/images/generations
PICGEN_DEFAULT_EDIT_URL=https://api.openai.com/v1/images/edits
PICGEN_DEFAULT_RESPONSES_URL=https://api.openai.com/v1/responses
PICGEN_DEFAULT_MODEL=gpt-image-2
PICGEN_DEFAULT_RESPONSES_MODEL=gpt-5.5
PICGEN_DEFAULT_SIZE=auto

# Server-side default API key (clients may leave the input blank).
PICGEN_DEFAULT_API_KEY=

# Optional bearer token enforced on /api/* (header X-Proxy-Token or Authorization).
PICGEN_PROXY_AUTH_TOKEN=

# ---- Upstream HTTP client tuning ---------------------------------------
PICGEN_UPSTREAM_TIMEOUT_SECONDS=1200
PICGEN_UPSTREAM_CONNECT_TIMEOUT_SECONDS=15
PICGEN_UPSTREAM_MAX_CONNECTIONS=64
PICGEN_UPSTREAM_MAX_KEEPALIVE=16
PICGEN_UPSTREAM_MAX_RETRIES=2
PICGEN_UPSTREAM_RETRY_BACKOFF=0.75
PICGEN_UPSTREAM_USER_AGENT=

# ---- Request limits ----------------------------------------------------
PICGEN_MAX_REQUEST_BODY_BYTES=67108864
PICGEN_MAX_IMAGE_BYTES=33554432
PICGEN_RATE_LIMIT_PER_MINUTE=120
PICGEN_RATE_LIMIT_BURST=20

# ---- Networking --------------------------------------------------------
# Comma-separated origins. Leave empty to disable CORS (recommended on localhost).
PICGEN_CORS_ALLOW_ORIGINS=
PICGEN_CORS_ALLOW_CREDENTIALS=false
# Enable when sitting behind a reverse proxy that sets X-Forwarded-For.
PICGEN_TRUST_FORWARDED_FOR=false

# ---- Observability -----------------------------------------------------
PICGEN_LOG_LEVEL=INFO
PICGEN_LOG_FORMAT=console
PICGEN_METRICS_ENABLED=false

# ---- Storage -----------------------------------------------------------
# Auto-purge day-folders older than N days. 0 disables pruning.
PICGEN_STORAGE_RETENTION_DAYS=0
